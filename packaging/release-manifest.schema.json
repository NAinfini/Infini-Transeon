{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infini-transeon.invalid/schema/release-manifest-v1.json",
  "title": "Infini-Transeon canonical release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseSequence", "releaseVersion", "channel", "architecture",
    "minimumWindowsBuild", "publishedAtUtc", "artifacts", "signatures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseSequence": { "type": "integer", "minimum": 1 },
    "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable"] },
    "architecture": { "const": "win-x64" },
    "minimumWindowsBuild": { "type": "integer", "minimum": 22621 },
    "publishedAtUtc": { "type": "string", "format": "date-time" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "signatures": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/signature" } }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "byteSize", "sha256", "codeSigning"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "codeSigning": { "enum": ["not-applicable", "unsigned", "authenticode"] },
        "authenticodePublisher": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "enum": ["Ed25519"] },
        "signature": { "type": "string", "contentEncoding": "base64" }
      }
    }
  },
  "$comment": "Sign canonical JSON with signatures omitted. Persist the highest accepted releaseSequence per channel. Trust roots contain current and next public keys; accept only known, non-revoked key IDs."
}

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" RequiredVersion="5.0.2">
  <Package
      Name="Infini-Transeon"
      Manufacturer="Infini-Transeon contributors"
      UpgradeCode="7B8B42BD-E465-44E6-ABBB-4A11354492BC"
      Version="$(Version)"
      Language="1033"
      Scope="perMachine"
      Compressed="yes">
    <SummaryInformation Description="Infini-Transeon Windows game translation overlay" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch
          Id="WindowsBuildNumberSearch"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentBuildNumber"
          Type="raw" />
    </Property>
    <Launch
        Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22621)"
        Message="Infini-Transeon requires a supported 64-bit Windows 11 release (build 22621 or newer)." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Infini-Transeon">
        <Component
            Id="MainApplication"
            Guid="5C2631CB-7C65-4CE6-835C-BE80C975588F"
            Bitness="always64">
          <File Id="MainApplicationExe" Source="$(PublishDir)\InfiniTranseon.App.exe" KeyPath="yes">
            <Shortcut
                Id="StartMenuShortcut"
                Directory="ProgramMenuFolder"
                Name="Infini-Transeon"
                WorkingDirectory="INSTALLFOLDER"
                Advertise="yes" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="Infini-Transeon" Level="1">
      <ComponentRef Id="MainApplication" />
      <Files Include="$(PublishDir)\**\*" Directory="INSTALLFOLDER">
        <Exclude Files="$(PublishDir)\InfiniTranseon.App.exe" />
      </Files>
    </Feature>
  </Package>
</Wix>

<!--
  THESIS: the region list is a complete keyboard and screen-reader alternative to the canvas —
  every region and every canvas command is reachable here without a pointer.
  Extracted from Features/Workbench/OpticalWorkbenchPage.xaml.
-->
<UserControl
    x:Class="InfiniTranseon.App.Controls.RegionListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:viewModels="using:InfiniTranseon.App.Presentation.ViewModels"
    IsTabStop="False">
    <Border
        Style="{StaticResource CardBorderStyle}"
        Padding="{StaticResource InsetM}">
        <Grid RowSpacing="{StaticResource SpaceS}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="RegionTreeHeader"
                FontWeight="SemiBold"
                Margin="2,0,0,2" />
            <ListView
                x:Uid="WorkbenchRegionList"
                x:Name="RegionListView"
                Grid.Row="1"
                SelectionMode="Single"
                SelectionChanged="OnRegionSelectionChanged"
                IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:WorkbenchRegionItem">
                        <Grid Padding="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- MinWidth defeats the ~120px default a bare CheckBox reserves for the
                                 content it does not have here; that reservation ate the star column
                                 and left the region name trimmed to two characters. -->
                            <CheckBox
                                MinWidth="0"
                                IsChecked="{x:Bind Enabled, Mode=OneWay}"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                Click="OnRegionEnabledClick" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind controls:RegionListPane.DescribePriority(Priority), Mode=OneWay}"
                                Style="{StaticResource CaptionTextStyle}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <CommandBar
                Grid.Row="2"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False">
                <AppBarButton
                    x:Uid="WorkbenchAddRegionButton"
                    Icon="Add"
                    Click="OnAddClick" />
                <AppBarButton
                    x:Uid="WorkbenchDuplicateRegionButton"
                    Icon="Copy"
                    Click="OnDuplicateClick" />
                <AppBarButton
                    x:Uid="WorkbenchDeleteRegionButton"
                    Icon="Delete"
                    Click="OnDeleteClick" />
                <AppBarSeparator />
                <AppBarButton
                    x:Uid="WorkbenchMoveRegionUpButton"
                    Icon="Up"
                    Click="OnMoveUpClick" />
                <!-- Symbol has Up but no Down; the missing member made this control unloadable.
                     E74B is the glyph Symbol.Up's counterpart draws from, so the pair still matches. -->
                <AppBarButton
                    x:Uid="WorkbenchMoveRegionDownButton"
                    Click="OnMoveDownClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>
    </Border>
</UserControl>

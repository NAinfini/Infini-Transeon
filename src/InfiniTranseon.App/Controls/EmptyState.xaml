<UserControl
    x:Class="InfiniTranseon.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    IsTabStop="False">
    <StackPanel
        Spacing="10"
        Margin="0,40,0,0"
        HorizontalAlignment="Center"
        automation:AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
        <FontIcon
            Glyph="{x:Bind Glyph, Mode=OneWay}"
            FontSize="34"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock
            Text="{x:Bind Title, Mode=OneWay}"
            HorizontalAlignment="Center"
            FontWeight="{StaticResource FontWeightStrong}" />
        <TextBlock
            Text="{x:Bind Body, Mode=OneWay}"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            Style="{StaticResource CaptionTextStyle}" />
        <ContentPresenter
            HorizontalAlignment="Center"
            Content="{x:Bind ActionContent, Mode=OneWay}" />
    </StackPanel>
</UserControl>

<!--
THESIS: One operational page owns one clear task and exposes its real state before its content.
OWN-WORLD: Native Fluent surfaces, restrained accent, semantic status, and the shared spacing scale.
STORY: The user sees where they are, what they can do, and whether data is loading, empty, or failed.
FIRST VIEWPORT: Title and commands lead; one mutually exclusive state fills the centered content area.
FORM: Profile-first application workspace, approved Fluent V1 direction; no concept seed was required.
-->
<UserControl
    x:Class="InfiniTranseon.App.Controls.PageShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    IsTabStop="False">
    <Grid
        MaxWidth="{StaticResource ContentMaxWidth}"
        Padding="{StaticResource PagePadding}"
        HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource SectionSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock
                    Text="{x:Bind Title, Mode=OneWay}"
                    Style="{StaticResource PageTitleStyle}"
                    automation:AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="{x:Bind Subtitle, Mode=OneWay}"
                    Style="{StaticResource BodyTextStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
            </StackPanel>
            <ContentPresenter
                Grid.Column="1"
                Margin="{StaticResource HeaderCommandMargin}"
                VerticalAlignment="Top"
                Content="{x:Bind HeaderCommands, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel
                x:Name="LoadingState"
                Spacing="{StaticResource SpaceM}"
                Visibility="Collapsed"
                automation:AutomationProperties.LiveSetting="Polite">
                <ProgressBar
                    x:Uid="PageShellLoading"
                    IsIndeterminate="True" />
                <controls:SkeletonCard />
            </StackPanel>

            <controls:ErrorBar
                x:Name="ErrorState"
                Visibility="Collapsed"
                IsActive="True"
                Message="{x:Bind ErrorMessage, Mode=OneWay}"
                Details="{x:Bind ErrorDetails, Mode=OneWay}"
                RetryCommand="{x:Bind RetryCommand, Mode=OneWay}" />

            <controls:EmptyState
                x:Name="EmptyStateHost"
                Visibility="Collapsed"
                Glyph="{x:Bind EmptyGlyph, Mode=OneWay}"
                Title="{x:Bind EmptyTitle, Mode=OneWay}"
                Body="{x:Bind EmptyBody, Mode=OneWay}"
                ActionContent="{x:Bind EmptyAction, Mode=OneWay}" />

            <ContentPresenter
                x:Name="ContentState"
                Content="{x:Bind PageContent, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>

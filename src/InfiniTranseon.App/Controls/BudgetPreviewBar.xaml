<UserControl
    x:Class="InfiniTranseon.App.Controls.BudgetPreviewBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Border
        Background="{ThemeResource SurfaceSunken}"
        CornerRadius="{StaticResource ControlCorner}"
        Padding="{StaticResource SettingRowPadding}">
        <Grid ColumnSpacing="{StaticResource SpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Glyph="&#xE9D2;"
                FontSize="{StaticResource TypeBodyLarge}"
                Foreground="{ThemeResource AccentText}" />
            <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXS}">
                <TextBlock
                    x:Name="SummaryText"
                    FontWeight="{StaticResource FontWeightStrong}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="BudgetPreviewHint"
                    Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

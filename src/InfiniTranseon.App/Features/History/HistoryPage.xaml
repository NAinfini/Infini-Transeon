<Page
    x:Class="InfiniTranseon.App.Features.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.Presentation"
    xmlns:local="using:InfiniTranseon.App.Features.History"
    Loaded="OnLoaded">
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="HistoryTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="HistorySubtitle" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <InfoBar
                x:Uid="LoadErrorBar"
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <ProgressBar
                x:Uid="PageLoadingIndicator"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <InfoBar
                x:Uid="HistoryDisabledBar"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsGlobalHistoryDisabled, Mode=OneWay}" />

            <InfoBar
                x:Uid="ProfileHistoryDisabledBar"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsProfileHistoryDisabled, Mode=OneWay}" />

            <Border
                Style="{StaticResource SettingRowStyle}"
                Visibility="{x:Bind ViewModel.HasProfileHistoryConfiguration, Mode=OneWay}">
                <StackPanel Spacing="{StaticResource SpaceM}">
                    <Grid ColumnSpacing="{StaticResource SpaceXL}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource SpaceXS}">
                            <TextBlock x:Uid="ProfileHistorySettingsTitle" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock x:Uid="ProfileHistorySettingsHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ProfileHistoryEnabledToggle"
                            x:Uid="ProfileHistoryEnabledToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.ProfileHistoryEnabled, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanConfigureProfileHistory, Mode=OneWay}"
                            Toggled="OnProfileHistoryEnabledToggled" />
                    </Grid>

                    <Grid
                        x:Name="ProfileHistoryLimits"
                        ColumnSpacing="{StaticResource SpaceM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="HistoryAgeDaysBox"
                            x:Uid="HistoryAgeDaysBox"
                            Minimum="1"
                            Maximum="{x:Bind ViewModel.GlobalHistoryMaxAgeDays, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanEditProfileHistoryLimits, Mode=OneWay}"
                            SpinButtonPlacementMode="Compact"
                            ValidationMode="InvalidInputOverwritten" />
                        <NumberBox
                            x:Name="HistoryMaximumMegabytesBox"
                            x:Uid="HistoryMaximumMegabytesBox"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="1048576"
                            IsEnabled="{x:Bind ViewModel.CanEditProfileHistoryLimits, Mode=OneWay}"
                            SpinButtonPlacementMode="Compact"
                            ValidationMode="InvalidInputOverwritten" />
                        <Button
                            x:Name="SaveProfileHistoryButton"
                            x:Uid="SaveProfileHistoryButton"
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind ViewModel.CanConfigureProfileHistory, Mode=OneWay}"
                            Click="OnSaveProfileHistoryClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The filters sit directly under the header, above whatever the page is showing. Placing
                 them after the empty state pushed them to the foot of a page-tall blank band on the
                 one occasion the user most needs them: when a search has returned nothing. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox x:Name="HistorySearchBox"
                                x:Uid="HistorySearchBox"
                                QueryIcon="Find"
                                MinWidth="260"
                                TextChanged="OnFilterChanged" />
                <controls:SelectBox x:Name="HistoryDateFilter"
                                    x:Uid="HistoryDateFilter"
                                    MinWidth="140"
                                    SelectedIndex="0"
                                    SelectionChanged="OnDateFilterChanged">
                    <ListViewItem x:Uid="HistoryDateAll" />
                    <ListViewItem x:Uid="HistoryDateToday" />
                    <ListViewItem x:Uid="HistoryDate7Days" />
                    <ListViewItem x:Uid="HistoryDate30Days" />
                </controls:SelectBox>
            </StackPanel>

            <StackPanel
                Spacing="8"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE81C;" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="HistoryEmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Uid="HistoryEmptyBody" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind DisplayGroups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryGroupDisplay">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="data:HistoryEvent">
                                        <controls:HistoryEventCard Item="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="InfiniTranseon.App.Features.Settings.ServicesModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.DesignData">
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="ServicesModelsTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="ServicesModelsSubtitle" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="AddProviderButton" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="AddProviderButtonLabel" />
                    </StackPanel>
                </Button>
                <Button x:Uid="AddRestAdapterButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE943;" FontSize="14" />
                        <TextBlock x:Uid="AddRestAdapterButtonLabel" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind Providers}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="data:ProviderRow">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE968;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="{StaticResource TypeBodyLarge}" />
                                        <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <controls:StatusBadge
                                    Grid.Column="2"
                                    Text="{x:Bind StateText}"
                                    Severity="{x:Bind StateSeverity}"
                                    VerticalAlignment="Center" />
                                <Button x:Uid="ConfigureProviderButton" Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Uid="ConfigureProviderButtonLabel" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>

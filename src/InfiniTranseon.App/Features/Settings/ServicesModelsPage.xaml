<!--
THESIS: Every translation, OCR, and local-model dependency is understandable before it is selected.
OWN-WORLD: Grouped provider inventory, inline endpoints, explicit credentials, and opt-in downloads.
STORY: Find a provider, see why it is or is not ready, configure only the missing piece.
FIRST VIEWPORT: Offline policy, search, and grouped cloud translation providers lead.
FORM: Global provider workspace in the approved native Fluent direction.
-->
<Page
    x:Class="InfiniTranseon.App.Features.Settings.ServicesModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.Presentation"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Page.Resources>
        <DataTemplate x:Key="ProviderCardTemplate" x:DataType="data:ProviderRow">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="{StaticResource SpaceM}">
                    <Grid ColumnSpacing="{StaticResource SpaceL}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE968;"
                            FontSize="20"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXS}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontWeight="SemiBold"
                                    FontSize="{StaticResource TypeBodyLarge}" />
                                <TextBlock
                                    Text="{x:Bind Kind}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Detail}"
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:StatusBadge
                            Grid.Column="2"
                            Text="{x:Bind StateText}"
                            Severity="{x:Bind StateSeverity}"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid
                        ColumnSpacing="{StaticResource SpaceS}"
                        Visibility="{x:Bind RequiresEndpoint}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Uid="ProviderInlineEndpointBox"
                            Text="{x:Bind Endpoint, Mode=TwoWay}"
                            PlaceholderText="{x:Bind EndpointPlaceholder}"
                            AutomationProperties.Name="{x:Bind Name}" />
                        <Button
                            x:Uid="ProviderSaveEndpointButton"
                            Grid.Column="1"
                            Tag="{x:Bind}"
                            VerticalAlignment="Bottom"
                            Click="OnSaveEndpointClick" />
                    </Grid>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceS}"
                        HorizontalAlignment="Right">
                        <Button
                            x:Uid="ConfigureProviderButton"
                            Visibility="{x:Bind CanConfigure}"
                            Tag="{x:Bind}"
                            Click="OnConfigureProviderClick">
                            <TextBlock x:Uid="ConfigureProviderButtonLabel" />
                        </Button>
                        <Button
                            x:Uid="InstallLocalModelButton"
                            Visibility="{x:Bind CanDownloadModel}"
                            Tag="{x:Bind}"
                            Click="OnInstallLocalModelClick" />
                        <Button
                            x:Uid="RemoveLocalModelButton"
                            Visibility="{x:Bind CanRemoveModel}"
                            Tag="{x:Bind}"
                            Click="OnRemoveLocalModelClick" />
                        <Button
                            x:Uid="RemoveCustomProviderButton"
                            Visibility="{x:Bind IsCustom}"
                            Tag="{x:Bind}"
                            Click="OnRemoveCustomProviderClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <controls:PageShell
            Title="{x:Bind ProvidersTitle, Mode=OneTime}"
            Subtitle="{x:Bind ProvidersSubtitle, Mode=OneTime}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            EmptyGlyph="&#xE968;"
            EmptyTitle="{x:Bind ProvidersEmptyTitle, Mode=OneTime}"
            EmptyBody="{x:Bind ProvidersEmptyBody, Mode=OneTime}">
            <controls:PageShell.HeaderCommands>
                <Button
                    x:Uid="AddRestAdapterButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddRestAdapterClick">
                    <TextBlock x:Uid="AddRestAdapterButtonLabel" />
                </Button>
            </controls:PageShell.HeaderCommands>
            <controls:PageShell.PageContent>
                <StackPanel Spacing="{StaticResource SpaceL}">
                    <InfoBar
                        x:Name="OfflineModeBar"
                        x:Uid="ProvidersOfflineModeBar"
                        Severity="Informational"
                        IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button
                                x:Uid="ProvidersOfflineModeGoToSettingsButton"
                                Click="OnGoToPrivacySettingsClick" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="PageNoticeBar"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Success" />
                    <Grid
                        ColumnSpacing="{StaticResource SpaceM}"
                        Visibility="{x:Bind ViewModel.IsModelOperationInProgress, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource SpaceXS}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ModelOperationStatus, Mode=OneWay}"
                                Style="{StaticResource CaptionTextStyle}" />
                            <ProgressBar
                                Minimum="0"
                                Maximum="100"
                                Value="{x:Bind ViewModel.ModelOperationPercent, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            x:Uid="CancelLocalModelOperationButton"
                            Grid.Column="1"
                            Click="OnCancelLocalModelOperationClick" />
                    </Grid>
                    <AutoSuggestBox
                        x:Name="ProviderSearchBox"
                        x:Uid="ProviderSearchBox"
                        QueryIcon="Find"
                        TextChanged="OnProviderFilterChanged" />

                    <StackPanel
                        x:Name="CloudTranslationSection"
                        Spacing="{StaticResource SpaceS}">
                        <TextBlock x:Uid="ProviderCloudTranslationHeader" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsRepeater
                            ItemsSource="{x:Bind CloudTranslationProviders}"
                            ItemTemplate="{StaticResource ProviderCardTemplate}">
                            <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource SpaceS}" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel
                        x:Name="CloudOcrSection"
                        Spacing="{StaticResource SpaceS}">
                        <TextBlock x:Uid="ProviderCloudOcrHeader" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsRepeater
                            ItemsSource="{x:Bind CloudOcrProviders}"
                            ItemTemplate="{StaticResource ProviderCardTemplate}">
                            <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource SpaceS}" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel
                        x:Name="LocalModelSection"
                        Spacing="{StaticResource SpaceS}">
                        <TextBlock x:Uid="ProviderLocalModelHeader" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsRepeater
                            ItemsSource="{x:Bind LocalModelProviders}"
                            ItemTemplate="{StaticResource ProviderCardTemplate}">
                            <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource SpaceS}" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel
                        x:Name="CustomProviderSection"
                        Spacing="{StaticResource SpaceS}">
                        <TextBlock x:Uid="ProviderCustomHeader" Style="{StaticResource SectionHeaderStyle}" />
                        <controls:EmptyState
                            x:Name="CustomProviderEmptyState"
                            x:Uid="CustomProviderEmptyState"
                            Glyph="&#xE8B5;" />
                        <ItemsRepeater
                            ItemsSource="{x:Bind CustomProviders}"
                            ItemTemplate="{StaticResource ProviderCardTemplate}">
                            <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource SpaceS}" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel
                        x:Name="OtherProviderSection"
                        Spacing="{StaticResource SpaceS}">
                        <TextBlock x:Uid="ProviderOtherHeader" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsRepeater
                            ItemsSource="{x:Bind OtherProviders}"
                            ItemTemplate="{StaticResource ProviderCardTemplate}">
                            <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource SpaceS}" /></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </controls:PageShell.PageContent>
        </controls:PageShell>
    </ScrollViewer>
</Page>

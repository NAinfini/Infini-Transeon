<!--
THESIS: Global behavior is searchable, grouped, and explicit about consequences.
OWN-WORLD: Native setting rows, a persistent section rail, and visible update trust state.
STORY: Find a setting, understand its scope, change it without hunting through a long page.
FIRST VIEWPORT: Search leads; a section rail and its matching content follow side by side.
FORM: Global settings workspace in the approved native Fluent direction.
-->
<Page
    x:Class="InfiniTranseon.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.Presentation"
    Loaded="OnLoaded">
    <ScrollViewer>
    <controls:PageShell
        Title="{x:Bind SettingsTitle, Mode=OneTime}"
        Subtitle="{x:Bind SettingsSubtitle, Mode=OneTime}"
        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
        ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
        <controls:PageShell.PageContent>
            <StackPanel Spacing="{StaticResource SpaceL}">
                <AutoSuggestBox
                    x:Name="SettingsSearchBox"
                    x:Uid="SettingsSearchBox"
                    QueryIcon="Find"
                    MaxWidth="{StaticResource FormMaxWidth}"
                    HorizontalAlignment="Left"
                    TextChanged="OnSettingsSearchChanged" />
                <controls:EmptyState
                    x:Name="SettingsSearchEmptyState"
                    x:Uid="SettingsSearchEmptyState"
                    Glyph="&#xE721;"
                    Visibility="Collapsed" />

                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="SettingsSectionList"
                        x:Uid="SettingsSectionList"
                        Grid.Column="0"
                        Width="{StaticResource PaneWidthWorkspaceNav}"
                        VerticalAlignment="Top"
                        SelectionMode="Single"
                        SelectionChanged="OnSettingsSectionChanged">
                        <!-- The initial selection is applied from the constructor, not with
                             IsSelected="True": the handler runs synchronously while the item is
                             parsed, which is before the section panels below exist. -->
                        <ListViewItem Tag="appearance"><TextBlock x:Uid="SettingsAppearanceTab" /></ListViewItem>
                        <ListViewItem Tag="hotkeys"><TextBlock x:Uid="SettingsHotkeysTab" /></ListViewItem>
                        <ListViewItem Tag="privacy"><TextBlock x:Uid="SettingsPrivacyTab" /></ListViewItem>
                        <ListViewItem Tag="performance"><TextBlock x:Uid="SettingsPerformanceTab" /></ListViewItem>
                        <ListViewItem Tag="about"><TextBlock x:Uid="SettingsAboutTab" /></ListViewItem>
                    </ListView>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="{StaticResource SpaceXL}"
                        MaxWidth="{StaticResource FormMaxWidth}"
                        HorizontalAlignment="Left">

                        <StackPanel x:Name="AppearancePanel" Spacing="{StaticResource SpaceS}">
                            <TextBlock x:Uid="AppearanceHeader" Style="{StaticResource SectionHeaderStyle}" />
                            <Border x:Name="ThemeSettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Name="ThemeSettingLabel" x:Uid="ThemeSettingLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="ThemeSettingHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeSelector" AutomationProperties.LabeledBy="{x:Bind ThemeSettingLabel}" Grid.Column="1" MinWidth="140" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem x:Uid="ThemeSystem" />
                                        <ComboBoxItem x:Uid="ThemeLight" />
                                        <ComboBoxItem x:Uid="ThemeDark" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border x:Name="LanguageSettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Name="LanguageSettingLabel" x:Uid="LanguageSettingLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="LanguageSettingHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageSelector" AutomationProperties.LabeledBy="{x:Bind LanguageSettingLabel}" Grid.Column="1" MinWidth="160" SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem x:Uid="LanguageOptionEnUs" />
                                        <ComboBoxItem x:Uid="LanguageOptionZhCn" />
                                    </ComboBox>
                                    <InfoBar
                                        x:Name="LanguageRestartBar"
                                        x:Uid="LanguageRestartBar"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,8,0,0"
                                        IsOpen="False"
                                        IsClosable="True"
                                        Severity="Informational" />
                                </Grid>
                            </Border>
                            <Border x:Name="ReducedMotionSettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Uid="ReducedMotionLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="ReducedMotionHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ReducedMotionToggle" x:Uid="ReducedMotionToggle" Grid.Column="1" MinWidth="0" Toggled="OnReducedMotionToggled" />
                                </Grid>
                            </Border>
                            <Border x:Name="CloseToTraySettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Uid="CloseToTraySettingLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="CloseToTraySettingHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CloseToTrayToggle" x:Uid="CloseToTrayToggle" Grid.Column="1" MinWidth="0" Toggled="OnCloseToTrayToggled" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HotkeysPanel" Spacing="{StaticResource SpaceS}" Visibility="Collapsed">
                            <TextBlock x:Uid="HotkeysHeader" Style="{StaticResource SectionHeaderStyle}" />
                            <InfoBar x:Name="HotkeyStatusBar" IsOpen="False" IsClosable="True" Severity="Warning" />
                            <Grid ColumnSpacing="{StaticResource SpaceM}" Padding="{StaticResource InsetS}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="HotkeyColumnAction" Style="{StaticResource CaptionTextStyle}" FontWeight="{StaticResource FontWeightStrong}" />
                                <TextBlock Grid.Column="1" x:Uid="HotkeyColumnGesture" Style="{StaticResource CaptionTextStyle}" FontWeight="{StaticResource FontWeightStrong}" />
                                <TextBlock Grid.Column="2" x:Uid="HotkeyColumnScope" Style="{StaticResource CaptionTextStyle}" FontWeight="{StaticResource FontWeightStrong}" />
                                <TextBlock Grid.Column="3" x:Uid="HotkeyColumnStatus" Style="{StaticResource CaptionTextStyle}" FontWeight="{StaticResource FontWeightStrong}" />
                                <TextBlock Grid.Column="4" x:Uid="HotkeyColumnEnabled" Style="{StaticResource CaptionTextStyle}" FontWeight="{StaticResource FontWeightStrong}" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hotkeys}">
                                <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource SpaceS}" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="data:HotkeyEditorRow">
                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid ColumnSpacing="{StaticResource SpaceM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind ActionText, Mode=OneWay}"
                                                    Style="{StaticResource BodyTextStyle}"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="{x:Bind Gesture, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    FontFamily="{StaticResource FontMono}"
                                                    Click="OnEditHotkeyClick" />
                                                <ComboBox
                                                    x:Uid="HotkeyScopeSelector"
                                                    Grid.Column="2"
                                                    MinWidth="150"
                                                    SelectedIndex="0">
                                                    <ComboBoxItem x:Uid="HotkeyScopeAllTargets" />
                                                    <ComboBoxItem x:Uid="HotkeyScopeForeground" IsEnabled="False" />
                                                    <ComboBoxItem x:Uid="HotkeyScopeSpecificGroup" IsEnabled="False" />
                                                </ComboBox>
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <ToggleSwitch
                                                    x:Uid="HotkeyEnabledToggle"
                                                    Grid.Column="4"
                                                    IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    MinWidth="0"
                                                    AutomationProperties.Name="{x:Bind ActionText, Mode=OneWay}"
                                                    Toggled="OnHotkeyEnabledToggled" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock x:Uid="HotkeyScopeLimitationHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <Button x:Uid="RestoreHotkeysButton" HorizontalAlignment="Left" Click="OnRestoreHotkeysClick" />
                        </StackPanel>

                        <StackPanel x:Name="PrivacyPanel" Spacing="{StaticResource SpaceS}" Visibility="Collapsed">
                            <TextBlock x:Uid="PrivacyHeader" Style="{StaticResource SectionHeaderStyle}" />
                            <Border x:Name="OfflineSettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Uid="OfflineModeLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="OfflineModeHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="OfflineToggle" x:Uid="OfflineToggle" Grid.Column="1" MinWidth="0" Toggled="OnOfflineToggled" />
                                </Grid>
                            </Border>
                            <Border x:Name="HistorySettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Name="HistoryRetentionLabel" x:Uid="HistoryRetentionLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="HistoryRetentionHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="RetentionSelector" AutomationProperties.LabeledBy="{x:Bind HistoryRetentionLabel}" Grid.Column="1" MinWidth="140" SelectionChanged="OnRetentionChanged">
                                        <ComboBoxItem x:Uid="HistoryOff" />
                                        <ComboBoxItem x:Uid="History30Days" />
                                        <ComboBoxItem x:Uid="History90Days" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PerformancePanel" Spacing="{StaticResource SpaceS}" Visibility="Collapsed">
                            <TextBlock x:Uid="PerformanceHeader" Style="{StaticResource SectionHeaderStyle}" />
                            <Border x:Name="PerformanceSettingRow" Style="{StaticResource SettingRowStyle}">
                                <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock x:Name="PerformancePresetLabel" x:Uid="PerformancePresetLabel" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:Uid="PerformancePresetHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" MaxWidth="620" />
                                    </StackPanel>
                                    <ComboBox x:Name="PerformanceSelector" AutomationProperties.LabeledBy="{x:Bind PerformancePresetLabel}" Grid.Column="1" MinWidth="160" SelectionChanged="OnPerformanceChanged">
                                        <ComboBoxItem x:Uid="PerformanceEco" />
                                        <ComboBoxItem x:Uid="PerformanceBalanced" />
                                        <ComboBoxItem x:Uid="PerformanceHigh" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutPanel" Spacing="{StaticResource SpaceS}" Visibility="Collapsed">
                            <TextBlock x:Uid="AboutHeader" Style="{StaticResource SectionHeaderStyle}" />
                            <Border x:Name="AboutSettingRow" Style="{StaticResource SettingRowStyle}">
                                <StackPanel Spacing="{StaticResource SpaceM}">
                                    <Grid ColumnSpacing="{StaticResource SpaceXL}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="{StaticResource SpaceXS}">
                                            <TextBlock Text="Infini-Transeon" FontWeight="{StaticResource FontWeightStrong}" />
                                            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock x:Uid="UpdatePolicyHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Uid="UpdateSignaturePolicyText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <ProgressRing x:Name="UpdateProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                            <Button x:Name="CheckUpdateButton" x:Uid="CheckUpdateButton" Click="OnCheckUpdateClick" />
                                            <Button x:Name="DownloadUpdateButton" x:Uid="DownloadUpdateButton" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="OnDownloadUpdateClick" />
                                            <Button x:Name="OpenInstallerButton" x:Uid="OpenInstallerButton" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="OnOpenInstallerClick" />
                                        </StackPanel>
                                    </Grid>
                                    <InfoBar x:Name="UpdateStatusBar" IsClosable="False" IsOpen="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </controls:PageShell.PageContent>
    </controls:PageShell>
    </ScrollViewer>
</Page>

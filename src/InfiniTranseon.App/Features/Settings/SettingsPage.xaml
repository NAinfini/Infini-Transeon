<Page
    x:Class="InfiniTranseon.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="SettingsSubtitle" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <TextBlock x:Uid="AppearanceHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="ThemeSettingLabel" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="ThemeSettingHint" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" VerticalAlignment="Center" MinWidth="140" SelectionChanged="OnThemeChanged" SelectedIndex="0">
                        <ComboBoxItem x:Uid="ThemeSystem" />
                        <ComboBoxItem x:Uid="ThemeLight" />
                        <ComboBoxItem x:Uid="ThemeDark" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="LanguageSettingLabel" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="LanguageSettingHint" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="140" SelectedIndex="0">
                        <ComboBoxItem Content="English (US)" />
                        <ComboBoxItem Content="简体中文" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Uid="PrivacyHeader" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="OfflineModeLabel" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="OfflineModeHint" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="HistoryRetentionLabel" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="HistoryRetentionHint" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="140" SelectedIndex="1">
                        <ComboBoxItem x:Uid="HistoryOff" />
                        <ComboBoxItem x:Uid="History30Days" />
                        <ComboBoxItem x:Uid="History90Days" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Uid="HotkeysHeader" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="ToggleOverlayHotkeyLabel" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="HotkeyRegisteredHint" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Ctrl + Alt + T" VerticalAlignment="Center" FontFamily="Cascadia Mono" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="PauseAllHotkeyLabel" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="HotkeyRegisteredHint" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Ctrl + Alt + P" VerticalAlignment="Center" FontFamily="Cascadia Mono" />
                </Grid>
            </Border>

            <TextBlock x:Uid="AboutHeader" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource SettingRowStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Infini-Transeon" FontWeight="SemiBold" />
                    <TextBlock Text="0.9.0-dev · Windows 11 x64" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:Uid="UpdatePolicyHint" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

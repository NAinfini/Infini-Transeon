<Page
    x:Class="InfiniTranseon.App.Features.Workbench.OpticalWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="WorkbenchTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="WorkbenchSubtitle" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Region tree: complete nonvisual alternative to the canvas -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="RegionTreeHeader" FontWeight="SemiBold" Margin="8,4" />
                    <TreeView>
                        <TreeView.RootNodes>
                            <TreeViewNode Content="ELDEN RING™ (window)" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Dialogue box · P0" />
                                    <TreeViewNode Content="HUD hint · P2" />
                                    <TreeViewNode Content="Item popup · P1" />
                                    <TreeViewNode Content="Tutorial panel · P3 · locked" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                        </TreeView.RootNodes>
                    </TreeView>
                </StackPanel>
            </Border>

            <!-- Capture canvas placeholder with sample region rectangles -->
            <Border Grid.Column="1" Background="{ThemeResource ThumbLetterboxBrush}" CornerRadius="{StaticResource CardCornerRadius}">
                <Grid>
                    <Border Background="{ThemeResource ThumbPlaceholderBrush}" Margin="40,24">
                        <Grid>
                            <TextBlock
                                x:Uid="CanvasPlaceholderHint"
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="#70FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Border
                                BorderBrush="#60CDFF"
                                BorderThickness="2"
                                Background="#1560CDFF"
                                Width="300"
                                Height="80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,32">
                                <TextBlock Text="Dialogue box · P0" FontSize="11" Foreground="#60CDFF" Margin="6,3" />
                            </Border>
                            <Border
                                BorderBrush="#6CCB5F"
                                BorderThickness="2"
                                Background="#156CCB5F"
                                Width="160"
                                Height="44"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,24,24,0">
                                <TextBlock Text="HUD hint · P2" FontSize="11" Foreground="#6CCB5F" Margin="6,3" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Region inspector grouped per plan Task 6 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="8">
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="InspectorHeader" FontWeight="SemiBold" Margin="8,4" />
                        <Expander x:Uid="InspectorBasic" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10" Padding="4">
                                <TextBox x:Uid="RegionNameBox" Text="Dialogue box" />
                                <ComboBox x:Uid="RegionPriorityBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="P0 — dialogue" />
                                    <ComboBoxItem Content="P1 — important" />
                                    <ComboBoxItem Content="P2 — ambient" />
                                    <ComboBoxItem Content="P3 — background" />
                                </ComboBox>
                                <ToggleSwitch x:Uid="RegionLockToggle" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Uid="InspectorOcr" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                        <Expander x:Uid="InspectorChannels" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                        <Expander x:Uid="InspectorOverlay" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                        <Expander x:Uid="InspectorLayout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                        <Expander x:Uid="InspectorPerformance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Single health strip with tabular numbers -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="{ThemeResource StatusSuccessBrush}" />
                    <TextBlock x:Uid="HealthStripCapture" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="60 fps" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE773;" FontSize="14" Foreground="{ThemeResource StatusSuccessBrush}" />
                    <TextBlock x:Uid="HealthStripOcr" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="P95 74 ms" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF2B7;" FontSize="14" Foreground="{ThemeResource StatusWarningBrush}" />
                    <TextBlock x:Uid="HealthStripPipeline" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="P95 348 ms" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE964;" FontSize="14" Foreground="{ThemeResource StatusSuccessBrush}" />
                    <TextBlock x:Uid="HealthStripMemory" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="412 MB" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

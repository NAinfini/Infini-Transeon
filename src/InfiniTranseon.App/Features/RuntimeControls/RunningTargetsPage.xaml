<Page
    x:Class="InfiniTranseon.App.Features.RuntimeControls.RunningTargetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.Presentation">
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="RunningTargetsTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="RunningTargetsSubtitle" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <!-- Engine status banner: localized state + verbatim error code / searched paths. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:StatusBadge
                            Text="{x:Bind StatusText(ViewModel.EngineStatus), Mode=OneWay}"
                            Severity="{x:Bind SeverityOf(ViewModel.EngineStatus), Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            MinWidth="260"
                            ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                            VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="data:ProfileCard">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Command="{x:Bind ViewModel.StartCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Uid="EngineStartButtonLabel" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.StopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock x:Uid="EngineStopButtonLabel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.EngineStatusDetail, Mode=OneWay}"
                        Visibility="{x:Bind HasDetail(ViewModel.EngineStatusDetail), Mode=OneWay}"
                        Style="{StaticResource CaptionTextStyle}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.TogglePauseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="14" />
                        <TextBlock Text="{x:Bind PauseLabel(ViewModel.IsPaused), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ToggleOverlayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                        <TextBlock Text="{x:Bind OverlayLabel(ViewModel.IsOverlayVisible), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ManualOcrCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE773;" FontSize="14" />
                        <TextBlock x:Uid="ManualOcrButtonLabel" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Uid="ManualOcrUnsupportedText"
                    Visibility="{x:Bind ViewModel.IsManualOcrUnavailable, Mode=OneWay}"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                x:Uid="RunningTargetsEmptyText"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                Style="{StaticResource CaptionTextStyle}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="data:RunningTarget">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ProfileName}" FontWeight="SemiBold" FontSize="{StaticResource TypeBodyLarge}" />
                                    <TextBlock Text="{x:Bind WindowTitle}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                    <TextBlock x:Uid="LatencyP95Label" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind LatencyP95}" Style="{StaticResource MetricTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                    <TextBlock x:Uid="ActiveRegionsLabel" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind ActiveRegions}" Style="{StaticResource MetricTextStyle}" />
                                </StackPanel>
                                <controls:StatusBadge
                                    Grid.Column="3"
                                    Text="{x:Bind HealthText}"
                                    Severity="{x:Bind HealthSeverity}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>

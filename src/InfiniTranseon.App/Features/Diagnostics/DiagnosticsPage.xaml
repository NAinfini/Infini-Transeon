<Page
    x:Class="InfiniTranseon.App.Features.Diagnostics.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.DesignData">
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="DiagnosticsTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="DiagnosticsSubtitle" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="ExportDiagnosticsButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <TextBlock x:Uid="ExportDiagnosticsButtonLabel" />
                    </StackPanel>
                </Button>
                <Button x:Uid="CrashReportsButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                        <TextBlock x:Uid="CrashReportsButtonLabel" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind Events}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="data:DiagnosticEvent">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource MetricTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Scope}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <controls:StatusBadge
                                        Text="{x:Bind Title}"
                                        Severity="{x:Bind Severity}"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{x:Bind CurrentBehavior}" Style="{StaticResource BodyTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <TextBlock Text="{x:Bind RecoveryAction}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="InfiniTranseon.App.Features.SetupWizard.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:InfiniTranseon.App.Presentation"
    xmlns:vm="using:InfiniTranseon.App.Presentation.ViewModels"
    xmlns:probes="using:InfiniTranseon.Contracts.Probes"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Loaded="OnLoaded"
    KeyDown="OnPageKeyDown"
    IsTabStop="True">

    <!--
      THESIS: first-run success, not feature completeness. Every step gates the next on real
      readiness (spec 5.2); nothing here fakes a passed test.
      FORM: a full-screen four-step guided flow — clickable step bar, a single scrollable step
      card, a persistent draft-exit action, and a footer nav whose Next explains itself when
      disabled (design system 9.4 "禁用但不解释是缺陷").
    -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title/subtitle + the persistent "save draft & exit" action (spec 5.2 "顶部
             '存草稿并退出'常驻"). -->
        <Grid ColumnSpacing="{StaticResource SpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="SetupWizardTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="SetupWizardSubtitle" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button
                x:Name="SaveDraftExitButton"
                x:Uid="SetupSaveDraftExitButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                IsEnabled="{x:Bind ViewModel.CanSaveDraft, Mode=OneWay}"
                Click="OnSaveDraftExitClick" />
        </Grid>

        <!-- Step bar: full clickable step bar (Wide/Compact), collapses to an "N/4" stepper
             below 820px (spec 5.2 "窄窗:步骤条折叠为 2/4 语言与服务 计步器"). -->
        <Grid Grid.Row="1">
            <Grid x:Name="StepBarFull" ColumnSpacing="{StaticResource SpaceS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="Step1Button"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsEnabled="{x:Bind ViewModel.IsStep1Reachable, Mode=OneWay}"
                    Click="OnStepButtonClick"
                    Tag="0">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="1" Style="{StaticResource MetricTextStyle}" />
                            <TextBlock x:Uid="SetupStep1Caption" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="Step2Button"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsEnabled="{x:Bind ViewModel.IsStep2Reachable, Mode=OneWay}"
                    Click="OnStepButtonClick"
                    Tag="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="2" Style="{StaticResource MetricTextStyle}" />
                            <TextBlock x:Uid="SetupStep2Caption" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="Step3Button"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsEnabled="{x:Bind ViewModel.IsStep3Reachable, Mode=OneWay}"
                    Click="OnStepButtonClick"
                    Tag="2">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="3" Style="{StaticResource MetricTextStyle}" />
                            <TextBlock x:Uid="SetupStep3Caption" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="Step4Button"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsEnabled="{x:Bind ViewModel.IsStep4Reachable, Mode=OneWay}"
                    Click="OnStepButtonClick"
                    Tag="3">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="4" Style="{StaticResource MetricTextStyle}" />
                            <TextBlock x:Uid="SetupStep4Caption" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.IsStep4, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock
                x:Name="StepBarCompact"
                Style="{StaticResource CaptionTextStyle}"
                Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
            <ScrollViewer>
                <Grid Padding="{StaticResource InsetM}">
                    <!-- Step 1: profile name + capture target selection + live preview -->
                    <Grid ColumnSpacing="{StaticResource SpaceL}" Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SetupStep1Heading" x:Uid="SetupStep1Heading" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox x:Uid="SetupProfileNameBox" Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}"
                                     MaxWidth="420" HorizontalAlignment="Left" />
                            <TextBlock x:Uid="SetupStep1Body" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <!-- Borderless capture consent needs package identity. Without it the OS
                                 draws its capture border over the game, which users read as a bug in
                                 this app. Say so here rather than only in the status log. -->
                            <InfoBar
                                x:Name="BorderlessCaptureInfoBar"
                                Severity="Informational"
                                IsClosable="True"
                                IsOpen="False" />
                            <ListView
                                      x:Name="CaptureTargetList"
                                      AutomationProperties.LabeledBy="{x:Bind SetupStep1Heading}"
                                      ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                                      SelectionChanged="OnCaptureTargetSelectionChanged"
                                      SelectionMode="Multiple" MaxHeight="260" HorizontalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="probes:CaptureProbeTarget">
                                        <!-- Without an explicit name the item peer falls back to the
                                             record's ToString(), so a screen reader read out the raw
                                             CaptureProbeTarget dump — window handle and process name
                                             included — instead of the target's title. -->
                                        <StackPanel Spacing="2" Padding="4"
                                                    AutomationProperties.Name="{x:Bind DisplayName}">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}">
                                                <Run Text="{x:Bind Kind}" /><Run Text=" · " /><Run Text="{x:Bind PixelWidth}" /><Run Text="×" /><Run Text="{x:Bind PixelHeight}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.CanUseDesktopFixedRegion, Mode=OneWay}">
                                <ToggleSwitch
                                    x:Uid="SetupDesktopRegionToggle"
                                    IsOn="{x:Bind ViewModel.UseDesktopFixedRegion, Mode=TwoWay}" />
                                <StackPanel
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.UseDesktopFixedRegion, Mode=OneWay}">
                                    <TextBlock
                                        x:Uid="SetupDesktopRegionHint"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8" RowSpacing="8" MaxWidth="520" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Uid="SetupDesktopRegionX"
                                            Minimum="-2147483648"
                                            Maximum="2147483647"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.DesktopRegionX, Mode=TwoWay}" />
                                        <NumberBox
                                            x:Uid="SetupDesktopRegionY"
                                            Grid.Column="1"
                                            Minimum="-2147483648"
                                            Maximum="2147483647"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.DesktopRegionY, Mode=TwoWay}" />
                                        <NumberBox
                                            x:Uid="SetupDesktopRegionWidth"
                                            Grid.Column="2"
                                            Minimum="1"
                                            Maximum="16384"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.DesktopRegionWidth, Mode=TwoWay}" />
                                        <NumberBox
                                            x:Uid="SetupDesktopRegionHeight"
                                            Grid.Column="3"
                                            Minimum="1"
                                            Maximum="16384"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.DesktopRegionHeight, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceS}">
                            <TextBlock x:Uid="SetupTargetPreviewHeader" FontWeight="SemiBold" />
                            <Border
                                Height="180"
                                Background="{ThemeResource ThumbLetterboxBrush}"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <Grid>
                                    <Image x:Name="TargetPreviewImage" Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="TargetPreviewPlaceholder"
                                        x:Uid="SetupTargetPreviewUnavailable"
                                        Style="{StaticResource CaptionTextStyle}"
                                        TextWrapping="Wrap"
                                        Padding="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2: languages + translator channel + credential entry + real test -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}">
                        <TextBlock x:Uid="SetupStep2Heading" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="SourceLanguageBox" x:Uid="SetupSourceLanguageBox"
                                            QueryIcon="Find" TextMemberPath="DisplayName"
                                            GotFocus="OnLanguageBoxGotFocus"
                                            LostFocus="OnSourceLanguageLostFocus"
                                            TextChanged="OnSourceLanguageTextChanged"
                                            SuggestionChosen="OnSourceLanguageSuggestionChosen"
                                            QuerySubmitted="OnSourceLanguageQuerySubmitted" />
                            <AutoSuggestBox x:Name="TargetLanguageBox" x:Uid="SetupTargetLanguageBox"
                                            Grid.Column="1" QueryIcon="Find" TextMemberPath="DisplayName"
                                            GotFocus="OnLanguageBoxGotFocus"
                                            LostFocus="OnTargetLanguageLostFocus"
                                            TextChanged="OnTargetLanguageTextChanged"
                                            SuggestionChosen="OnTargetLanguageSuggestionChosen"
                                            QuerySubmitted="OnTargetLanguageQuerySubmitted" />
                        </Grid>
                        <ComboBox x:Uid="SetupProviderSelector" MinWidth="280" HorizontalAlignment="Left"
                                  ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="data:ProviderRow">
                                    <StackPanel Spacing="2" Padding="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}">
                                            <Run Text="{x:Bind Kind}" /><Run Text=" · " /><Run Text="{x:Bind StateText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Uid="SetupSecretHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <Button x:Uid="SetupConfigureProviderButton"
                                Click="OnConfigureProviderClick"
                                HorizontalAlignment="Left" />

                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCorner}"
                            Padding="{StaticResource InsetM}"
                            MaxWidth="620"
                            HorizontalAlignment="Left">
                            <StackPanel Spacing="{StaticResource SpaceS}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}">
                                    <Button
                                        x:Uid="SetupTestTranslationButton"
                                        Command="{x:Bind ViewModel.TestTranslationCommand}" />
                                    <ProgressRing
                                        Width="18" Height="18"
                                        IsActive="{x:Bind ViewModel.IsTranslationTestBusy, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsTranslationTestBusy, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    x:Uid="SetupTestTranslationSampleLabel"
                                    Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TranslationTestResult, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind TextVisibility(ViewModel.TranslationTestResult), Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="{x:Bind FormatLatency(ViewModel.TranslationTestLatency), Mode=OneWay}"
                                    Visibility="{x:Bind TextVisibility(ViewModel.TranslationTestResult), Mode=OneWay}" />
                                <InfoBar
                                    x:Uid="SetupTestTranslationErrorTitle"
                                    Severity="Error"
                                    IsClosable="False"
                                    IsOpen="{x:Bind HasText(ViewModel.TranslationTestError), Mode=OneWay}"
                                    Message="{x:Bind DescribeTranslationTestError(ViewModel.TranslationTestError, ViewModel.TranslationTestErrorDetail), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 3: reused workspace region canvas (spec 5.2 "复用工作区画布组件") with a
                         simplified inspector (name/priority/context role only). -->
                    <Grid
                        x:Name="Step3Grid"
                        ColumnSpacing="{StaticResource SpaceM}"
                        RowSpacing="{StaticResource SpaceM}"
                        Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="460" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="SetupStep3Heading"
                            Grid.Row="0" Grid.ColumnSpan="3"
                            x:Uid="SetupStep3Heading"
                            Style="{StaticResource SectionHeaderStyle}" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{StaticResource SpaceS}">
                            <TextBlock x:Name="SetupRegionListHeader" x:Uid="SetupRegionListHeader" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="RegionNameBox" x:Uid="SetupRegionNameBox" />
                                <Button Grid.Column="1" x:Uid="SetupAddRegionButton" Click="OnAddRegionClick"
                                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                <ComboBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="RegionPrioritySelector"
                                          x:Uid="SetupRegionPriorityBox"
                                          SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="P0" />
                                    <ComboBoxItem Content="P1" />
                                    <ComboBoxItem Content="P2" />
                                    <ComboBoxItem Content="P3" />
                                </ComboBox>
                            </Grid>
                            <ListView
                                x:Name="RegionList"
                                AutomationProperties.LabeledBy="{x:Bind SetupRegionListHeader}"
                                ItemsSource="{x:Bind ViewModel.Regions, Mode=OneWay}"
                                SelectionChanged="OnRegionListSelectionChanged"
                                SelectionMode="Single"
                                MaxHeight="320"
                                HorizontalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkbenchRegionItem">
                                        <Grid ColumnSpacing="8" Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Priority, Mode=OneWay}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Uid="SetupRemoveRegionButton" Tag="{x:Bind}"
                                                    Click="OnRemoveRegionClick" MinWidth="32" MinHeight="32" Padding="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceS}">
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Left">
                                <AppBarToggleButton
                                    x:Name="DrawRegionButton"
                                    x:Uid="SetupDrawRegionButton"
                                    Icon="Edit"
                                    Checked="OnDrawRegionToggled"
                                    Unchecked="OnDrawRegionToggled" />
                            </CommandBar>
                            <controls:RegionCanvas
                                x:Name="Canvas"
                                x:Uid="SetupRegionCanvas"
                                Height="380"
                                SelectionChanged="OnCanvasSelectionChanged"
                                RegionAdded="OnCanvasRegionAdded"
                                RegionChanged="OnCanvasRegionChanged"
                                DrawModeExited="OnCanvasDrawModeExited" />
                        </StackPanel>

                        <Border
                            Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="{StaticResource InsetS}">
                            <ScrollViewer>
                                <StackPanel Spacing="{StaticResource SpaceM}">
                                    <TextBlock x:Uid="SetupInspectorHeader" FontWeight="SemiBold" />
                                    <TextBox x:Name="InspectorNameBox" x:Uid="SetupRegionNameBox" LostFocus="OnInspectorChanged" />
                                    <ComboBox
                                        x:Name="InspectorPriorityBox"
                                        x:Uid="SetupRegionPriorityBox"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnInspectorSelectionChanged">
                                        <ComboBoxItem Content="P0" />
                                        <ComboBoxItem Content="P1" />
                                        <ComboBoxItem Content="P2" />
                                        <ComboBoxItem Content="P3" />
                                    </ComboBox>
                                    <ComboBox
                                        x:Name="InspectorContextRoleBox"
                                        x:Uid="SetupRegionContextRoleSelector"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnInspectorSelectionChanged">
                                        <ComboBoxItem x:Uid="SetupRegionRoleNone" />
                                        <ComboBoxItem x:Uid="SetupRegionRoleSpeaker" />
                                        <ComboBoxItem x:Uid="SetupRegionRoleScene" />
                                        <ComboBoxItem x:Uid="SetupRegionRoleDialogue" />
                                    </ComboBox>
                                    <Button
                                        x:Uid="SetupTestOcrButton"
                                        Click="OnTestOcrClick" />
                                    <ProgressRing
                                        Width="18" Height="18"
                                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="OcrResultLabel"
                                        x:Uid="SetupOcrTestResultLabel"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="OcrResultText"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <InfoBar
                                        x:Name="OcrInfoBar"
                                        IsOpen="False"
                                        IsClosable="True" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Step 4: review + save -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStep4, Mode=OneWay}">
                        <TextBlock x:Uid="SetupStep4Heading" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Uid="SetupStep4Body"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap"
                            MaxWidth="680"
                            HorizontalAlignment="Left" />
                        <TextBlock x:Uid="SetupSummaryProfileLabel" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource TypeBodyLarge}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}">
                            <Run Text="{x:Bind ViewModel.SourceLanguage, Mode=OneWay}" /><Run Text=" → " /><Run Text="{x:Bind ViewModel.TargetLanguage, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="SetupSummaryTargetsLabel" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedTargets.Count, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="SetupSummaryRegionsLabel" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Regions.Count, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCorner}"
                            Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="SetupReadinessHeader" FontWeight="SemiBold" />
                                <Button x:Uid="SetupCaptureReadyButton" Click="OnReadinessItemClick" Tag="0"
                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                                    <CheckBox
                                        x:Uid="SetupCaptureReady"
                                        IsChecked="{x:Bind ViewModel.HasReadyTarget, Mode=OneWay}"
                                        IsHitTestVisible="False" />
                                </Button>
                                <Button x:Uid="SetupLanguagesReadyButton" Click="OnReadinessItemClick" Tag="1"
                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                                    <CheckBox
                                        x:Uid="SetupLanguagesReady"
                                        IsChecked="{x:Bind ViewModel.HasReadyLanguages, Mode=OneWay}"
                                        IsHitTestVisible="False" />
                                </Button>
                                <Button x:Uid="SetupProviderReadyButton" Click="OnReadinessItemClick" Tag="1"
                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                                    <CheckBox
                                        x:Uid="SetupProviderReady"
                                        IsChecked="{x:Bind ViewModel.HasReadyProvider, Mode=OneWay}"
                                        IsHitTestVisible="False" />
                                </Button>
                                <Button x:Uid="SetupRegionsReadyButton" Click="OnReadinessItemClick" Tag="2"
                                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                                    <CheckBox
                                        x:Uid="SetupRegionsReady"
                                        IsChecked="{x:Bind ViewModel.HasReadyRegions, Mode=OneWay}"
                                        IsHitTestVisible="False" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="SetupOverlayPreviewHeader" FontWeight="SemiBold" />
                        <Border
                            Background="{ThemeResource ThumbLetterboxBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource InsetM}"
                            MaxWidth="480"
                            HorizontalAlignment="Left">
                            <StackPanel Spacing="{StaticResource SpaceS}">
                                <Border
                                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCorner}"
                                    Padding="10,6"
                                    HorizontalAlignment="Left">
                                    <TextBlock
                                        x:Uid="SetupOverlayPreviewSampleText"
                                        Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            x:Uid="SetupOverlayPreviewDisclaimer"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap"
                            MaxWidth="480"
                            HorizontalAlignment="Left" />

                        <InfoBar x:Uid="SetupSaveErrorBar" Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <Button x:Uid="SetupBackButton" HorizontalAlignment="Left" MinWidth="120"
                    Command="{x:Bind ViewModel.BackCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock x:Uid="SetupBackButtonLabel" />
                </StackPanel>
            </Button>
            <StackPanel HorizontalAlignment="Right" Spacing="4"
                        Visibility="{x:Bind InverseVisibility(ViewModel.IsLastStep), Mode=OneWay}">
                <Button x:Uid="SetupNextButton" HorizontalAlignment="Right" MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                        Command="{x:Bind ViewModel.NextCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="SetupNextButtonLabel" />
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Name="NextBlockedReasonText"
                    Style="{StaticResource CaptionTextStyle}"
                    HorizontalAlignment="Right"
                    TextWrapping="Wrap"
                    MaxWidth="360" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsLastStep, Mode=OneWay}">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    VerticalAlignment="Center" />
                <Button
                    x:Uid="SetupSaveOnlyButton"
                    MinWidth="120"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Click="OnSaveOnlyClick" />
                <Button
                    x:Uid="SetupSaveButton"
                    MinWidth="170"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Click="OnSaveAndStartTestClick" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="StepBarFull.Visibility" Value="Collapsed" />
                        <Setter Target="StepBarCompact.Visibility" Value="Visible" />
                    </VisualState.Setters>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>

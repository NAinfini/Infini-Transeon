<Page
    x:Class="InfiniTranseon.App.Features.Workspace.ChannelsSectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    Loaded="OnLoaded"
    IsTabStop="True">

    <!--
      THESIS: translation channels are the product's core differentiator, so they get a dedicated,
      inline pipeline editor instead of a code-behind modal.
      STORY: pick a region → see its channel cards (translator → up to 2 refiners) → reorder/edit
      inline → watch the quota and worst-case budget update live.
      FORM: region selector + budget header, then stacked pipeline cards (spec 5.5).
    -->
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="{StaticResource SpaceM}">
            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock x:Uid="WorkspaceChannelsTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Uid="WorkspaceChannelsSubtitle"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap"
                    MaxWidth="760"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <InfoBar x:Name="PageInfoBar" IsOpen="False" IsClosable="True" />

            <Grid ColumnSpacing="{StaticResource SpaceM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Uid="WorkbenchTargetSelector"
                    x:Name="TargetSelector"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnTargetSelectionChanged" />
                <ComboBox
                    x:Uid="ChannelsRegionSelector"
                    x:Name="RegionSelector"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnRegionSelectionChanged" />
            </Grid>

            <StackPanel x:Name="HeaderPanel" Spacing="{StaticResource SpaceM}">
                <ToggleSwitch
                    x:Name="TranslationEnabledToggle"
                    x:Uid="WorkbenchTranslationEnabledToggle"
                    Toggled="OnTranslationEnabledToggled" />

                <controls:BudgetPreviewBar x:Name="BudgetPreview" />

                <Grid ColumnSpacing="{StaticResource SpaceM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <TextBlock x:Name="QuotaText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="QuotaLimitText"
                            x:Uid="ChannelsQuotaLimitReached"
                            Style="{StaticResource CaptionTextStyle}"
                            Foreground="{ThemeResource StatusWarningBrush}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Button
                        x:Name="AddChannelButton"
                        x:Uid="WorkbenchAddChannelButton"
                        Grid.Column="1"
                        Click="OnAddChannelClick" />
                </Grid>

                <StackPanel x:Name="CardsHost" Spacing="{StaticResource SpaceM}" />

                <controls:EmptyState x:Name="EmptyStateHost" Glyph="&#xE8F2;" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="InfiniTranseon.App.Features.Workspace.CaptureSectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    KeyDown="OnPageKeyDown"
    IsTabStop="True">

    <!--
      THESIS: calibrate translation zones against the game itself.
      OWN WORLD: the existing restrained WinUI/Mica operating surface.
      STORY: choose target → draw/adjust region → inspect → save and hot-apply.
      FIRST VIEWPORT: target row, true preview canvas, a three-group inspector, honest status.
      FORM: an adaptive three-pane editor with a complete list-based keyboard path (spec 5.4).
    -->
    <Grid
        x:Name="LayoutRoot"
        Padding="{StaticResource PagePadding}"
        RowSpacing="{StaticResource SpaceM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource SpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock x:Uid="WorkspaceCaptureTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Uid="WorkspaceCaptureSubtitle"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap"
                    MaxWidth="760"
                    HorizontalAlignment="Left" />
            </StackPanel>
            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="UndoButton" x:Uid="WorkbenchUndoButton" Icon="Undo" Click="OnUndoClick" />
                <AppBarButton x:Name="RedoButton" x:Uid="WorkbenchRedoButton" Icon="Redo" Click="OnRedoClick" />
            </CommandBar>
        </Grid>

        <InfoBar x:Name="PageInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            Padding="{StaticResource InsetM}">
            <StackPanel Spacing="{StaticResource SpaceS}">
                <Grid ColumnSpacing="{StaticResource SpaceM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Uid="WorkbenchTargetSelector"
                        x:Name="TargetSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnTargetSelectionChanged" />
                    <CommandBar
                        Grid.Column="1"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True">
                        <AppBarToggleButton
                            x:Name="DrawRegionButton"
                            x:Uid="WorkbenchDrawRegionButton"
                            Icon="Edit"
                            Checked="OnDrawRegionToggled"
                            Unchecked="OnDrawRegionToggled" />
                        <AppBarButton
                            x:Uid="WorkbenchRefreshPreviewButton"
                            Icon="Refresh"
                            Click="OnRefreshPreviewClick" />
                        <AppBarSeparator />
                        <!-- "FitPage" is not a Symbol member; the invalid name threw XamlParseException
                             and made the whole capture section unreachable. E9A6 is the fit-page glyph. -->
                        <AppBarButton x:Uid="WorkbenchZoomFitButton" Click="OnZoomFitClick">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE9A6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>
                <Expander
                    x:Uid="TargetSettingsExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="{StaticResource SpaceM}" RowSpacing="{StaticResource SpaceS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="DetectionLongEdgeBox"
                            x:Uid="WorkbenchDetectionLongEdgeBox"
                            Minimum="320"
                            Maximum="1920"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnTargetNumberChanged" />
                        <ToggleSwitch
                            x:Name="ScanRemainingAreaToggle"
                            x:Uid="WorkbenchScanRemainingAreaToggle"
                            Grid.Column="1"
                            Toggled="OnTargetSettingsChanged" />
                        <NumberBox
                            x:Name="RemainingAreaIntervalBox"
                            x:Uid="WorkbenchRemainingAreaIntervalBox"
                            Grid.Column="2"
                            Minimum="100"
                            Maximum="3600000"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnTargetNumberChanged" />
                    </Grid>
                </Expander>
            </StackPanel>
        </Border>

        <Grid
            x:Name="EditorGrid"
            Grid.Row="3"
            ColumnSpacing="{StaticResource SpaceM}"
            RowSpacing="{StaticResource SpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="240" />
                <ColumnDefinition x:Name="CanvasColumn" Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TreeRow" Height="*" />
                <RowDefinition x:Name="CanvasRow" Height="0" />
                <RowDefinition x:Name="InspectorRow" Height="0" />
            </Grid.RowDefinitions>

            <controls:RegionListPane
                x:Name="RegionList"
                SelectionChanged="OnRegionListSelectionChanged"
                RegionEnabledChanged="OnRegionEnabledChanged"
                AddRequested="OnAddRegionRequested"
                DuplicateRequested="OnDuplicateRegionRequested"
                DeleteRequested="OnDeleteRegionRequested"
                MoveUpRequested="OnMoveRegionUpRequested"
                MoveDownRequested="OnMoveRegionDownRequested" />

            <controls:RegionCanvas
                x:Name="Canvas"
                Grid.Column="1"
                SelectionChanged="OnCanvasSelectionChanged"
                RegionDragStarted="OnCanvasRegionDragStarted"
                RegionAdded="OnCanvasRegionAdded"
                RegionChanged="OnCanvasRegionChanged"
                DrawModeExited="OnCanvasDrawModeExited" />

            <Border
                x:Name="InspectorPane"
                Grid.Column="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="{StaticResource InsetXS}">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpaceXS}">
                        <TextBlock x:Uid="InspectorHeader" FontWeight="SemiBold" Margin="8,4" />

                        <Expander
                            x:Uid="InspectorBasic"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource SpaceM}" Padding="4,8">
                                <TextBox x:Name="RegionNameBox" x:Uid="RegionNameBox" LostFocus="OnInspectorChanged" />
                                <ToggleSwitch
                                    x:Name="RegionEnabledToggle"
                                    x:Uid="WorkbenchRegionEnabledToggle"
                                    Toggled="OnInspectorChanged" />
                                <ComboBox
                                    x:Name="RegionPriorityBox"
                                    x:Uid="RegionPriorityBox"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnInspectorSelectionChanged">
                                    <ComboBoxItem Content="P0" />
                                    <ComboBoxItem Content="P1" />
                                    <ComboBoxItem Content="P2" />
                                    <ComboBoxItem Content="P3" />
                                </ComboBox>
                                <TextBlock
                                    x:Uid="WorkbenchPriorityHint"
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="ContextRoleBox"
                                    x:Uid="WorkbenchContextRoleBox"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnInspectorSelectionChanged">
                                    <ComboBoxItem x:Uid="WorkbenchRoleNone" />
                                    <ComboBoxItem x:Uid="WorkbenchRoleSpeaker" />
                                    <ComboBoxItem x:Uid="WorkbenchRoleScene" />
                                    <ComboBoxItem x:Uid="WorkbenchRoleDialogue" />
                                </ComboBox>
                                <TextBlock
                                    x:Uid="WorkbenchContextRoleHint"
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    x:Name="RegionLockToggle"
                                    x:Uid="RegionLockToggle"
                                    Toggled="OnInspectorChanged" />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Uid="InspectorOcr"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource SpaceM}" Padding="4,8">
                                <ComboBox
                                    x:Name="OcrProviderBox"
                                    x:Uid="WorkbenchOcrProviderBox"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    HorizontalAlignment="Stretch"
                                    LostFocus="OnInspectorChanged" />
                                <ComboBox
                                    x:Name="RecognitionLanguageBox"
                                    x:Uid="WorkbenchRecognitionLanguageBox"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    HorizontalAlignment="Stretch"
                                    LostFocus="OnInspectorChanged" />
                                <ToggleSwitch
                                    x:Name="DetectOrientationToggle"
                                    x:Uid="WorkbenchDetectOrientationToggle"
                                    Toggled="OnInspectorChanged" />
                                <ToggleSwitch
                                    x:Name="CloudOcrToggle"
                                    x:Uid="WorkbenchCloudOcrToggle"
                                    Toggled="OnCloudOcrToggled" />
                                <Expander
                                    x:Uid="InspectorOcrAdvanced"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="{StaticResource SpaceM}" Padding="4,8">
                                        <NumberBox
                                            x:Name="RecognitionIntervalBox"
                                            x:Uid="WorkbenchRecognitionIntervalBox"
                                            Minimum="16"
                                            Maximum="3600000"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnInspectorNumberChanged" />
                                        <NumberBox
                                            x:Name="DetectionScaleBox"
                                            x:Uid="WorkbenchDetectionScaleBox"
                                            Minimum="0.1"
                                            Maximum="1"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnInspectorNumberChanged" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Uid="InspectorLayout"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource SpaceM}" Padding="4,8">
                                <ComboBox
                                    x:Name="LineBreakModeBox"
                                    x:Uid="WorkbenchLineBreakModeBox"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnInspectorSelectionChanged">
                                    <ComboBoxItem x:Uid="LineBreakPreserve" Tag="PreserveLines" />
                                    <ComboBoxItem x:Uid="LineBreakJoin" Tag="JoinParagraph" />
                                    <ComboBoxItem x:Uid="LineBreakKeyValue" Tag="KeyValueRows" />
                                    <ComboBoxItem x:Uid="LineBreakCustom" Tag="CustomSeparator" />
                                    <ComboBoxItem x:Uid="LineBreakPerBox" Tag="PerBox" />
                                </ComboBox>
                                <TextBox
                                    x:Name="CustomSeparatorBox"
                                    x:Uid="WorkbenchCustomSeparatorBox"
                                    LostFocus="OnInspectorChanged" />
                                <ComboBox
                                    x:Name="LineAlignmentBox"
                                    x:Uid="WorkbenchLineAlignmentBox"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnInspectorSelectionChanged">
                                    <ComboBoxItem x:Uid="LineAlignmentAuto" Tag="Auto" />
                                    <ComboBoxItem x:Uid="LineAlignmentLeft" Tag="Left" />
                                    <ComboBoxItem x:Uid="LineAlignmentCenter" Tag="Center" />
                                    <ComboBoxItem x:Uid="LineAlignmentRight" Tag="Right" />
                                </ComboBox>
                                <NumberBox
                                    x:Name="MaximumLinesBox"
                                    x:Uid="WorkbenchMaximumLinesBox"
                                    Minimum="1"
                                    Maximum="2048"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OnInspectorNumberChanged" />
                                <Grid ColumnSpacing="{StaticResource SpaceS}" RowSpacing="{StaticResource SpaceS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox
                                        x:Name="RegionXBox"
                                        Header="X"
                                        Minimum="0"
                                        Maximum="1"
                                        SmallChange="0.01"
                                        ValueChanged="OnBoundsNumberChanged" />
                                    <NumberBox
                                        x:Name="RegionYBox"
                                        Grid.Column="1"
                                        Header="Y"
                                        Minimum="0"
                                        Maximum="1"
                                        SmallChange="0.01"
                                        ValueChanged="OnBoundsNumberChanged" />
                                    <NumberBox
                                        x:Name="RegionWidthBox"
                                        Grid.Row="1"
                                        Header="W"
                                        Minimum="0.01"
                                        Maximum="1"
                                        SmallChange="0.01"
                                        ValueChanged="OnBoundsNumberChanged" />
                                    <NumberBox
                                        x:Name="RegionHeightBox"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Header="H"
                                        Minimum="0.01"
                                        Maximum="1"
                                        SmallChange="0.01"
                                        ValueChanged="OnBoundsNumberChanged" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Style="{StaticResource CardBorderStyle}"
            Padding="14,9">
            <Grid ColumnSpacing="{StaticResource SpaceL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <FontIcon x:Name="PreviewStatusIcon" Glyph="&#xE950;" FontSize="14" />
                    <TextBlock
                        x:Name="PreviewStatusText"
                        x:Uid="WorkbenchPreviewIdle"
                        Style="{StaticResource CaptionTextStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    x:Name="GeometryStatusText"
                    Grid.Column="1"
                    Style="{StaticResource MetricTextStyle}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="DirtyStatusText"
                    Grid.Column="2"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.Setters>
                        <Setter Target="TreeColumn.Width" Value="210" />
                        <Setter Target="InspectorColumn.Width" Value="280" />
                    </VisualState.Setters>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="TreeColumn.Width" Value="*" />
                        <Setter Target="InspectorColumn.Width" Value="0" />
                        <Setter Target="RegionList.(Grid.Column)" Value="0" />
                        <Setter Target="RegionList.(Grid.Row)" Value="0" />
                        <Setter Target="Canvas.(Grid.Column)" Value="0" />
                        <Setter Target="Canvas.(Grid.Row)" Value="1" />
                        <Setter Target="InspectorPane.(Grid.Column)" Value="0" />
                        <Setter Target="InspectorPane.(Grid.Row)" Value="2" />
                        <Setter Target="EditorGrid.ColumnSpacing" Value="0" />
                        <Setter Target="TreeRow.Height" Value="220" />
                        <Setter Target="CanvasRow.Height" Value="420" />
                        <Setter Target="InspectorRow.Height" Value="420" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>

<Page
    x:Class="InfiniTranseon.App.Features.ProfileCenter.ProfileCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InfiniTranseon.App.Controls"
    xmlns:data="using:InfiniTranseon.App.Presentation">
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="ProfilesTitle" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Uid="ProfilesSubtitle" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <Button
                    x:Uid="NewProfileButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="OnNewProfileClick"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="NewProfileButtonLabel" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsRepeater ItemsSource="{x:Bind Profiles}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="320"
                        MinRowSpacing="16"
                        MinColumnSpacing="16"
                        ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="data:ProfileCard">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <StackPanel>
                                <!-- Letterboxed thumbnail area with stable outer dimensions -->
                                <Grid Height="168" Background="{ThemeResource ThumbLetterboxBrush}" CornerRadius="8,8,0,0">
                                    <Border
                                        Background="{ThemeResource ThumbPlaceholderBrush}"
                                        Width="280"
                                        VerticalAlignment="Stretch"
                                        Margin="0,6">
                                        <FontIcon
                                            Glyph="&#xE7F4;"
                                            FontSize="28"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <controls:StatusBadge
                                        Text="{x:Bind MatchStateText}"
                                        Severity="{x:Bind MatchSeverity}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="10,10,0,0" />
                                    <TextBlock
                                        Text="{x:Bind Resolution}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Foreground="#D0FFFFFF"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,10,8" />
                                </Grid>
                                <StackPanel Padding="16,12,16,16" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontSize="{StaticResource TypeBodyLarge}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TargetDescription}" Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xF2B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Languages}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE8A9;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}">
                                                <Run Text="{x:Bind RegionCount}" /><Run Text=" regions · " /><Run Text="{x:Bind ChannelCount}" /><Run Text=" channels" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Button Content="{x:Bind PrimaryAction}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <Button x:Uid="EditProfileButton" MinWidth="32" MinHeight="32" Padding="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            </Button>
                                            <Button x:Uid="MoreProfileActionsButton" MinWidth="32" MinHeight="32" Padding="6">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing scale (epx) -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>
    <Thickness x:Key="PagePadding">32,24,32,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,24</Thickness>

    <!-- Corners -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCorner">4</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">10</CornerRadius>

    <!-- Typography: 14 epx body minimum, 12 epx auxiliary minimum -->
    <x:Double x:Key="TypeCaption">12</x:Double>
    <x:Double x:Key="TypeBody">14</x:Double>
    <x:Double x:Key="TypeBodyLarge">16</x:Double>
    <x:Double x:Key="TypeSubtitle">20</x:Double>
    <x:Double x:Key="TypeTitle">28</x:Double>

    <!-- Minimum hit target (compact mode) -->
    <x:Double x:Key="MinHitTarget">32</x:Double>

    <!-- Profile card: stable outer dimensions, 16:9 letterbox area -->
    <x:Double x:Key="ProfileCardWidth">320</x:Double>
    <x:Double x:Key="ProfileCardThumbHeight">168</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#DFF6DD" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusCriticalBackgroundBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="StatusNeutralBrush" Color="#5D5F66" />
            <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#EDEDED" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#DDEDFB" />
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#1A1C23" />
            <SolidColorBrush x:Key="ThumbLetterboxBrush" Color="#0C0D11" />
            <SolidColorBrush x:Key="OverlayPreviewGameBrush" Color="#23252E" />
            <SolidColorBrush x:Key="OverlayPreviewPanelBrush" Color="#E6101218" />
            <SolidColorBrush x:Key="OverlayPreviewTextBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#1B3B1B" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#433519" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusCriticalBackgroundBrush" Color="#442726" />
            <SolidColorBrush x:Key="StatusNeutralBrush" Color="#C5C8CE" />
            <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#333538" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#20344A" />
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#1A1C23" />
            <SolidColorBrush x:Key="ThumbLetterboxBrush" Color="#0C0D11" />
            <SolidColorBrush x:Key="OverlayPreviewGameBrush" Color="#23252E" />
            <SolidColorBrush x:Key="OverlayPreviewPanelBrush" Color="#E6101218" />
            <SolidColorBrush x:Key="OverlayPreviewTextBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ThumbLetterboxBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayPreviewGameBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayPreviewPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayPreviewTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

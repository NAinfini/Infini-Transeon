<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page title -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypeTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightStrong}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Section header -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypeSubtitle}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightStrong}" />
        <Setter Property="Margin" Value="{StaticResource SectionHeaderMargin}" />
    </Style>

    <!-- Auxiliary/caption text: 12 epx minimum -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Body text -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Card surface -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Settings row card -->
    <Style x:Key="SettingRowStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="{StaticResource SettingRowPadding}" />
        <Setter Property="Margin" Value="{StaticResource SettingRowMargin}" />
    </Style>

    <!-- Tabular numbers for metrics -->
    <Style x:Key="MetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    </Style>
</ResourceDictionary>

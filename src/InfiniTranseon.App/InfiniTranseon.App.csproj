<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>InfiniTranseon.App</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en-US;zh-CN</SatelliteResourceLanguages>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InfiniTranseon.Contracts\InfiniTranseon.Contracts.csproj" />
    <ProjectReference Include="..\InfiniTranseon.Core\InfiniTranseon.Core.csproj" />
  </ItemGroup>
  <Target Name="GenerateUnpackagedPri" AfterTargets="Build" Condition="'$(WindowsPackageType)' == 'None'">
    <Error
      Condition="!Exists('$(MakePriExeFullPath)')"
      Text="MakePri.exe was not found at '$(MakePriExeFullPath)'." />
    <Error
      Condition="!Exists('$(IntermediateOutputPath)priconfig.xml')"
      Text="The generated PRI configuration is missing: '$(IntermediateOutputPath)priconfig.xml'." />
    <Exec
      Command="&quot;$(MakePriExeFullPath)&quot; new /pr &quot;$(MSBuildProjectDirectory)&quot; /cf &quot;$(IntermediateOutputPath)priconfig.xml&quot; /of &quot;$(TargetDir)resources.pri&quot; /o" />
  </Target>
  <Target
    Name="PublishUnpackagedPri"
    AfterTargets="Publish"
    DependsOnTargets="GenerateUnpackagedPri"
    Condition="'$(WindowsPackageType)' == 'None'">
    <Copy
      SourceFiles="$(TargetDir)resources.pri"
      DestinationFiles="$(PublishDir)resources.pri" />
  </Target>
</Project>

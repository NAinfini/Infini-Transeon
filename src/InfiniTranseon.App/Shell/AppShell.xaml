<Window
    x:Class="InfiniTranseon.App.Shell.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Infini-Transeon">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarArea"
            Padding="16,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xF2B7;" FontSize="16" VerticalAlignment="Center" />
                <TextBlock
                    Text="Infini-Transeon"
                    FontSize="{StaticResource TypeCaption}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Button
                x:Name="RuntimeStatusPill"
                Grid.Column="2"
                Padding="10,4"
                CornerRadius="{StaticResource BadgeCornerRadius}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                Click="OnRuntimeStatusClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        x:Name="RuntimeStatusGlyph"
                        Glyph="&#xE8BB;"
                        FontSize="{StaticResource TypeCaption}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="RuntimeStatusText"
                        x:Uid="RuntimeStatusText"
                        FontSize="{StaticResource TypeCaption}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                x:Name="UpdateNotice"
                Grid.Row="0"
                x:Uid="UpdateAvailableNotice"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="UpdateAvailableNoticeButton"
                        Click="OnReviewUpdateClick" />
                </InfoBar.ActionButton>
            </InfoBar>
            <NavigationView
                x:Name="Nav"
                Grid.Row="1"
                IsBackButtonVisible="Auto"
                IsBackEnabled="False"
                IsSettingsVisible="False"
                PaneDisplayMode="Left"
                OpenPaneLength="220"
                CompactPaneLength="48"
                BackRequested="OnNavBackRequested"
                SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GlobalHomeItem" x:Uid="NavHome" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceHomeItem" x:Uid="NavWorkspaceHome" Tag="workspace-home" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceOverviewItem" x:Uid="NavWorkspaceOverview" Tag="overview" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceCaptureItem" x:Uid="NavWorkspaceCapture" Tag="capture" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceChannelsItem" x:Uid="NavWorkspaceChannels" Tag="channels" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceOverlayItem" x:Uid="NavWorkspaceOverlay" Tag="overlay" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceLanguageItem" x:Uid="NavWorkspaceLanguage" Tag="language" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkspaceHistoryItem" x:Uid="NavWorkspaceHistory" Tag="history" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavActivity" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavProviders" Tag="providers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSettings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>

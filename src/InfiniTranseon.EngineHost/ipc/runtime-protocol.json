{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infini-Transeon Runtime Protocol v1",
  "protocolVersion": 1,
  "encoding": "binary envelope; UTF-8 only for text-bearing payload fields explicitly defined by a message contract",
  "framing": "signed little-endian 32-bit body-length prefix validated as positive before allocation",
  "maxMessageBytes": 8388608,
  "maxInFlightBytes": 33554432,
  "wireEnvelope": {
    "lengthPrefixBytes": 4,
    "headerBytes": 56,
    "byteOrder": "little-endian",
    "magic": "ITRP",
    "protocolVersionOffset": 4,
    "messageKindOffset": 8,
    "requestIdOffset": 12,
    "runtimeEpochOffset": 28,
    "deadlineOffset": 44,
    "deadlineEncoding": "utc-ticks",
    "payloadLengthOffset": 52
  },
  "messageKinds": [
    "HandshakeRequest",
    "HandshakeResponse",
    "ControlRequest",
    "ControlResponse",
    "TargetSnapshot",
    "TargetLifecycle",
    "OcrResult",
    "CloudOcrCropRequest",
    "TranslationOutput",
    "TranslationStreamSnapshot",
    "OverlayDesiredState",
    "PolicyRevision",
    "PolicyAcknowledgement",
    "DegradationSnapshot",
    "DiagnosticEvent",
    "Thumbnail",
    "ReconnectSnapshot",
    "ShutdownRequest",
    "ShutdownAcknowledgement"
  ],
  "ordering": "request-scoped sequence and runtime epoch",
  "reconnect": "full state snapshot; never replay text or provider completions"
}

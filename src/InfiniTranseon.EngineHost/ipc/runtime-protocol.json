{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infini-Transeon Runtime Protocol v1",
  "protocolVersion": 1,
  "encoding": "binary envelope; UTF-8 only for text-bearing payload fields explicitly defined by a message contract",
  "framing": "signed little-endian 32-bit body-length prefix validated as positive before allocation",
  "maxMessageBytes": 8388608,
  "maxInFlightBytes": 33554432,
  "bootstrapTransport": {
    "framing": "unsigned little-endian 32-bit payload-length prefix with a 512-byte hard ceiling",
    "secretDelivery": "inherited-anonymous-pipe-read-handle",
    "explicitHandleListOnly": true,
    "secretExcludedFrom": [
      "command-line",
      "environment",
      "logs",
      "persistent-files"
    ],
    "fields": [
      "magic",
      "protocolVersion",
      "expectedClientProcessId",
      "runtimeEpoch",
      "nonce",
      "pipeName"
    ]
  },
  "namedPipeSecurity": {
    "localMachineOnly": true,
    "firstInstance": true,
    "rejectRemoteClients": true,
    "acl": "current-logon-user",
    "handshakeBinds": [
      "actualClientProcessId",
      "claimedClientProcessId",
      "expectedServerProcessId",
      "runtimeEpoch",
      "oneTimeNonce"
    ]
  },
  "postHandshake": {
    "ownership": "one serialized request-response owner per connection",
    "heartbeatRequest": "ControlRequest",
    "heartbeatResponse": "ControlResponse",
    "shutdownRequest": "ShutdownRequest",
    "shutdownResponse": "ShutdownAcknowledgement",
    "unsupportedMessageBehavior": "explicit protocol failure and connection termination"
  },
  "backpressure": {
    "controlMaxItems": 64,
    "dataMaxItems": 8,
    "controlMaxBytes": 1048576,
    "dataMaxBytes": 33554432,
    "sharedMaxBytes": 33554432,
    "dataLaneKinds": [
      "CloudOcrCropRequest",
      "Thumbnail"
    ],
    "rejection": "immediate explicit failure without waiting or silent dropping"
  },
  "restartPolicy": "caller-configured-finite-window",
  "wireEnvelope": {
    "lengthPrefixBytes": 4,
    "headerBytes": 56,
    "byteOrder": "little-endian",
    "magic": "ITRP",
    "protocolVersionOffset": 4,
    "messageKindOffset": 8,
    "requestIdOffset": 12,
    "runtimeEpochOffset": 28,
    "deadlineOffset": 44,
    "deadlineEncoding": "utc-ticks",
    "payloadLengthOffset": 52
  },
  "messageKinds": [
    "HandshakeRequest",
    "HandshakeResponse",
    "ControlRequest",
    "ControlResponse",
    "TargetSnapshot",
    "TargetLifecycle",
    "OcrResult",
    "CloudOcrCropRequest",
    "TranslationOutput",
    "TranslationStreamSnapshot",
    "OverlayDesiredState",
    "PolicyRevision",
    "PolicyAcknowledgement",
    "DegradationSnapshot",
    "DiagnosticEvent",
    "Thumbnail",
    "ReconnectSnapshot",
    "ShutdownRequest",
    "ShutdownAcknowledgement"
  ],
  "ordering": "request-scoped sequence and runtime epoch",
  "reconnect": "full state snapshot; never replay text or provider completions"
}
